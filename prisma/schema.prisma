generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Designer {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String
  email     String  @unique
  bio       String? @db.Text
  photoUrl  String?

  title      String?
  company    String?
  linkedinUrl String?
  websiteUrl  String?

  primaryRole     String
  otherRoles      String[]
  location        String
  experienceLevel String
  typeOfRole      String[]
  companySize     String[]  @default([])
  skills          String[]  @default([])
  industries      String[]  @default([])
  startAvailability String?
  remotePreference  String?
  compensation    String?
  requiresVisa    Boolean  @default(false)

  openToWork WorkStatus @default(OPEN)
  timing     String?

  publicProfile       Boolean @default(true)
  shareConfidentially Boolean @default(false)
  hidden              Boolean   @default(false)
  lastConfirmedAt     DateTime?
  confirmSentAt       DateTime?
  profileViews        Int       @default(0)

  // Featured work
  projects        Json?     @default("[]")

  // Fun profile extras
  funFacts        String?   @db.Text
  mostProudOf     String?
  pets            String?
  recentlyRead    String?
  languagesSpoken String[]  @default([])
  instruments     String?
  hobbies         String?

  editToken        String    @unique @default(cuid())
  magicToken       String?   @unique
  magicTokenExpiry DateTime?

  // Job alerts: designers opt in from /alerts (reached by editToken from email)
  // and pick a cadence; the weekly cron sends roles scored against their
  // profile and logs each one so nothing is sent twice.
  alertFrequency    AlertFrequency @default(NONE)
  alertOptInAt      DateTime?
  alertLastSentAt   DateTime?
  alertInviteSentAt DateTime?  // the one-off "still looking?" campaign
  wantsLeadership   Boolean    @default(false)
  jobAlertLogs      JobAlertLog[]
  // Custom saved-search alerts (paid tier). memberEmail is a second address
  // for the membership match when the board email differs from the one they
  // subscribe with; status is re-checked before every send.
  jobAlerts         JobAlert[]
  memberEmail       String?
  memberStatus      String?    // active | past_due | none
  memberCheckedAt   DateTime?

  @@index([publicProfile, hidden, openToWork])
  @@index([alertFrequency])
  @@map("designers")
}

enum AlertFrequency {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// Funnel events for designer emails: invite_click, prefs_saved, stop,
/// job_view, apply_click. Designer and job are plain ids (no FK) so a deleted
/// profile or pruned job leaves the funnel numbers intact.
model AlertEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  kind       String
  designerId String?
  jobId      String?
  source     String?
  detail     String?

  @@index([kind, createdAt])
  @@index([designerId])
  @@map("alert_events")
}

/// A saved search a designer asked to be emailed. Criteria use the same
/// parameter names as /api/v1/jobs. Paused rather than deleted when the
/// membership lapses, so a resubscribe brings it back.
model JobAlert {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  designerId   String
  name         String
  criteria     Json
  frequency    AlertFrequency @default(WEEKLY)
  lastSentAt   DateTime?
  pausedAt     DateTime?
  pausedReason String?        // not_member | user | thin
  designer     Designer       @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@index([designerId])
  @@index([frequency, pausedAt])
  @@map("job_alerts")
}

model JobAlertLog {
  id         String   @id @default(cuid())
  designerId String
  jobId      String
  sentAt     DateTime @default(now())
  designer   Designer @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@unique([designerId, jobId])
  @@index([designerId])
  @@map("job_alert_logs")
}

enum WorkStatus {
  OPEN
  OPEN_SOON
  NOT_LOOKING
}

model SuccessStory {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  designerId   String
  designerName String
  quote        String   @db.Text
  company      String?
  newRole      String?
  approved     Boolean  @default(false)
  public       Boolean  @default(false)

  @@map("success_stories")
}

model JobMatchLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  jobId      String
  designerId String
  score      Int

  @@unique([jobId, designerId])
  @@map("job_match_logs")
}

model Coupon {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  code          String    @unique
  description   String?
  discountType  String
  discountValue Int
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  active        Boolean   @default(true)

  @@map("coupons")
}

model Job {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posterFirstName String
  posterLastName  String
  posterEmail     String

  company        String
  companyUrl     String?
  companyLogoUrl String?

  title           String
  role            String
  description     String?  @db.Text
  jobUrl          String?
  location        String
  remote          Boolean  @default(false)
  experienceLevel String
  compensation    String?
  visaSponsorship Boolean  @default(false)
  typeOfRole      String
  companySize     String?

  active    Boolean   @default(false)
  featured  Boolean   @default(false)
  expiresAt DateTime?

  stripeSessionId     String? @unique
  stripePaymentStatus String?

  viewCount   Int    @default(0)
  manageToken String @unique @default(cuid())

  matchFrequency    String?   // "once" | "weekly" | "biweekly"
  lastMatchSentAt   DateTime?
  repostNudgeSentAt DateTime?
  // Set once this job has appeared in the #hiring Slack digest, so it is never
  // posted twice. Written only after Slack confirms the message was sent.
  slackPostedAt     DateTime?
  // When another service (db-community) fetches a digest it *claims* these rows
  // rather than marking them posted, then acks once Slack accepted the message.
  // A claim that is never acked lapses, so a failed run retries instead of
  // silently swallowing the roles.
  slackBatchId      String?
  slackClaimedAt    DateTime?
  // Leads a design function (Head of / VP / Director / design manager) as
  // opposed to a senior IC. Kept separate from `role` because leadership is
  // orthogonal to discipline — you can lead product design or brand.
  leadership        Boolean   @default(false)
  // Set when the job is copied into the newsletter digest, so next week's
  // "suggest 5" never re-offers it.
  digestedAt        DateTime?

  @@index([active, createdAt])
  @@index([active, leadership])
  @@index([slackBatchId])
  @@map("jobs")
}
